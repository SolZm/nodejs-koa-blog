# just a flag
NUXT_APP_ENV = 'production'

# 浏览器端调接口用「同源相对路径」
# 走 http 还是 https 都自动对，切 HTTPS 时不用再改构建产物；
# 也顺带把服务器 IP 从 JS 里去掉，换服务器/换域名不用重新构建
BASE_URL = '/api/v1'

# 服务端渲染（SSR）在 Node 里跑，axios 必须拿到绝对地址，
# 给相对路径会直接报 Invalid URL，所以这里直连本机 Koa，少绕一圈 nginx 和 TLS
API_INTERNAL_URL = 'http://127.0.0.1:3000/api/v1'

BOBLOG_TOKEN = 'BOBLOG_TOKEN'

# AI 问答：改成 true 可以在没有后端时用本地假数据预览交互
AI_MOCK = 'false'
