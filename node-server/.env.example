# 环境变量模板
#
# 用法：复制为 .env 再按实际情况填写。.env 已被 .gitignore 忽略，不会入库。
#   cp .env.example .env

# 运行环境：dev / production
# 注意：一旦设为 production，下面 DB_* 和 JWT_SECRET 就变成必填，缺失会导致进程直接退出（故意的）
NODE_ENV=dev

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boblog

# ---- 安全 ----
# JWT 签名密钥，生产环境务必换成足够长的随机串
JWT_SECRET=
# JWT 过期时间（秒），默认 3600
JWT_EXPIRES_IN=3600

# ---- AI ----
# mock：不调用任何外部服务，用确定性哈希生成伪向量，便于本地把整条链路跑通
# openai：走 OpenAI 兼容协议，下面 chat / embedding 两组各自独立配置
AI_PROVIDER=mock

# 对话（生成）—— 想换厂商只改这三行
# 例：DeepSeek 用 https://api.deepseek.com/v1
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
# 例：deepseek-chat；博客问答用 qwen-plus 也够（实测比 122b 的 MoE 模型快 2.3 倍）
AI_CHAT_MODEL=

# 对话降级链（可选）：主模型超时/限流/不可用时按顺序尝试备用。
# 格式：多组用 ; 分隔，每组三个字段用 | 分隔 —— baseUrl|apiKey|model
# 建议配一个**不同厂商**的模型，这样一家挂了不影响整体可用。
# AI_CHAT_FALLBACKS=https://dashscope.aliyuncs.com/compatible-mode/v1|sk-xxx|qwen-plus

# 向量（检索）—— 必须是有 embedding 接口的服务，不能和对话混为一谈：
# DeepSeek 没有 embedding 接口，所以换了对话模型后这一组通常要保留原来的
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
# 例：text-embedding-v3（百炼）
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=1024

# 通用兜底：上面两组没单独配时，会回退到这两个
AI_BASE_URL=
AI_API_KEY=

# 博客资料阈值：召回相似度低于它时，本轮不采用博客资料，但仍会生成通用技术说明
# 不填则按 provider 取默认值（mock 0.14 / openai 0.6）
# 注意：这个值和向量模型强相关，换模型后要用评测集重新标定
# AI_MIN_RELEVANCE=

# ---- 对象存储（七牛云）----
# 图片上传用。密钥在七牛控制台「密钥管理」里取，填在 .env（不是这里）。
#
# 提醒：这对密钥曾经明文写在 app/api/v1/upload.js 里并提交进了 git 历史，
# 已经算泄露过一次。用控制台重新生成，只把新值写进 .env。
# 这个是模板文件、会入库，所以这里只留空占位，任何情况下都不要填真值。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
